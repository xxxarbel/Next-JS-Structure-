# The template for .env: `pnpm env:init` creates .env from it with a free
# database port. .env is git-ignored.

# Local database (docker-compose.yml reads these too). Give every project its own
# POSTGRES_PORT so their databases can run side by side, and keep the port in
# DATABASE_URL the same.
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# The app and drizzle-kit connect with this. On ATS Hosting the platform sets it
# to the project's own database.
DATABASE_URL=postgres://app:app@localhost:5432/app
